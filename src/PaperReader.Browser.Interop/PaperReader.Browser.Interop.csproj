<Project Sdk="Microsoft.NET.Sdk">
  <!-- The browser's JavaScript functions (wwwroot/interop.js). [JSImport] needs the C# source generator,
       so these declarations live here and the rest of the browser app stays in F#. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
</Project>
