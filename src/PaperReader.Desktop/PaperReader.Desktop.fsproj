<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>paper-reader</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DesktopPlatform.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PaperReader\PaperReader.fsproj" />
  </ItemGroup>
</Project>
